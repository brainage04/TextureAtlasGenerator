{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "Generate vanilla and Hypixel SkyBlock texture atlases.",
	"authors": ["brainage04"],
	"contact": {
		"homepage": "https://github.com/brainage04/TextureAtlasGenerator",
		"sources": "https://github.com/brainage04/TextureAtlasGenerator"
	},
	"license": "MIT",
	"icon": "assets/textureatlasgenerator/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["io.github.brainage04.textureatlasgenerator.fabric.TextureAtlasGeneratorFabric"],
		"modmenu": ["io.github.brainage04.textureatlasgenerator.modmenu.ModMenuIntegration"]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
